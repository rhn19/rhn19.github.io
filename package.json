{
  "name": "rhn19.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio website for Rohan Bhide",
  "scripts": {
    "start": "npx serve -l 3000",
    "test": "node tests/validate.js",
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"css/**/*.css\"",
    "a11y": "pa11y http://localhost:3000 --standard WCAG2AA",
    "validate": "npm run lint:html && npm run lint:css"
  },
  "devDependencies": {
    "html-validate": "11.2.0",
    "pa11y": "9.1.1",
    "serve": "14.2.6",
    "stylelint": "17.13.0",
    "stylelint-config-standard": "40.0.0"
  }
}
